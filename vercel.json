{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/summary", "destination": "/api/index.py" },
    { "source": "/transactions", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/reconcile", "destination": "/api/index.py" },
    { "source": "/reconcile-csv", "destination": "/api/index.py" },
    { "source": "/css/(.*)", "destination": "/dashboard/css/$1" },
    { "source": "/js/(.*)", "destination": "/dashboard/js/$1" },
    { "source": "/", "destination": "/dashboard/index.html" },
    { "source": "/(.*)", "destination": "/dashboard/$1" }
  ]
}
